# ==============================================================================
# F.R.I.D.A.Y. — Environment Configuration
# Futuristic Responsive Intelligent Digital Assistant for You
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Backend URL for Streamlit
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# AI Provider Configuration
# Supported providers: gemini, openai, ollama, mock
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash
VISION_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=text-embedding-004
IMAGE_MODEL_NAME=imagen-3.0-generate-002

# Local fallback / Ollama configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=friday_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# Vector Store & RAG Configuration
# ------------------------------------------------------------------------------
VECTOR_STORE_DIR=data/chroma
UPLOAD_DIR=data/uploads
GENERATED_DIR=data/generated
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# Optional Spotify Integration
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ------------------------------------------------------------------------------
# Desktop Automation Safety
# ------------------------------------------------------------------------------
DESKTOP_CONTROL_ENABLED=true
ALLOW_DANGEROUS_OPERATIONS=false
